      SFName       ""\
      Path         ""\
      SrcLocation  "GNC2026W:31793:64-71"\
    }\
    ChartData {\
      Name         "counter_not_empty"\
      Description  "EmlPersistentSentinel"\
      SFName       ""\
      Path         ""\
      SrcLocation  "GNC2026W:31793:64-71"\
    }\
    ChartData {\
      Name         "firstfit"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "GNC2026W:31793:72-80"\
    }\
    ChartData {\
      Name         "firstfit_not_empty"\
      Description  "EmlPersistentSentinel"\
      SFName       ""\
      Path         ""\
      SrcLocation  "GNC2026W:31793:72-80"\
    }\
    ChartData {\
      Name         "prev"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "GNC2026W:31793:81-85"\
    }\
    ChartData {\
      Name         "prev_not_empty"\
      Description  "EmlPersistentSentinel"\
      SFName       ""\
      Path         ""\
      SrcLocation  "GNC2026W:31793:81-85"\
    }\
    ChartData {\
      Name         "phase"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "GNC2026W:31793:86-91"\
    }\
    ChartData {\
      Name         "phase_not_empty"\
      Description  "EmlPersistentSentinel"\
      SFName       ""\
      Path         ""\
      SrcLocation  "GNC2026W:31793:86-91"\
    }\
  }
  %return ChartDataElements
%endfunction
