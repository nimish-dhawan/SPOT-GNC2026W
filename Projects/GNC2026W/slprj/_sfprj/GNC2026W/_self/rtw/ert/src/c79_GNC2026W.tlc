%endfunction
%function ChartDataMap(block, system) void
  %createrecord ChartDataElements {\
    NumChartData   4 \
    ChartDataDefaults {\
      RecordType   "ChartData"\
      Dimensions   []\
      IsTestPoint  0\
    }\
    ChartData {\
      Name         "k"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "GNC2026W:31850:128-129"\
    }\
    ChartData {\
      Name         "store"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "GNC2026W:31850:142-147"\
      Dimensions   [2,200]\
    }\
    ChartData {\
      Name         "sendPacket"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "GNC2026W:31850:159-169"\
    }\
    ChartData {\
      Name         "packetSent"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "GNC2026W:31850:181-191"\
    }\
  }
  %return ChartDataElements
%endfunction
