      Dimensions   []\
      IsTestPoint  0\
    }\
    ChartData {\
      Name         "Hold"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "GNC2026W:32752:50-54"\
    }\
    ChartData {\
      Name         "location"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "GNC2026W:32752:66-74"\
      Dimensions   [3]\
    }\
  }
  %return ChartDataElements
%endfunction
